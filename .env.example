# URL base de la API backend.
# En desarrollo local con Vite Proxy, puedes dejarlo vacío o comentar esta línea para usar '/api/v1'.
# En producción o cuando no uses el proxy de Vite, especifica la URL completa:
# VITE_API_URL=http://localhost:3000/api/v1
VITE_API_URL=

# ID de cliente de Google Cloud OAuth 2.0 (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=

